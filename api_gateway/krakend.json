{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 4,
  "name": "servicio-pago-arriendo-gateway",
  "port": 8080,
  "timeout": "5s",
  "max_idle_connections": 100,
  "max_idle_connections_per_host": 20,
  "idle_connection_timeout": "60s",
  "dialer_timeout": "1s",
  "response_header_timeout": "4s",
  "cache_ttl": "0s",
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "host": ["http://arriendos-api:8080"],
          "url_pattern": "/health",
          "encoding": "json"
        }
      ],
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 20,
          "every": "1s",
          "capacity": 20,
          "client_max_rate": 5,
          "client_capacity": 5,
          "strategy": "ip"
        }
      }
    },
    {
      "endpoint": "/api/rentals",
      "method": "GET",
      "input_headers": ["API-Key"],
      "input_query_strings": ["limit", "offset"],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://arriendos-api:8080"],
          "url_pattern": "/v2/rentals",
          "encoding": "no-op",
          "extra_config": {
            "qos/circuit-breaker": {
              "interval": 60,
              "timeout": 10,
              "max_errors": 3,
              "name": "cb-rentals-list",
              "log_status_change": true
            }
          }
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "audience": ["servicio-pago-arriendo"],
          "disable_jwk_security": true,
          "issuer": "servicio-pago-arriendo-test",
          "jwk_local_path": "/etc/krakend/jwk-symmetric.json",
          "roles": ["cliente", "admin"],
          "roles_key": "roles"
        },
        "qos/ratelimit/router": {
          "max_rate": 100,
          "every": "1s",
          "capacity": 100,
          "client_max_rate": 10,
          "client_capacity": 10,
          "strategy": "ip"
        }
      }
    },
    {
      "endpoint": "/api/rentals",
      "method": "POST",
      "input_headers": ["API-Key", "Content-Type", "Idempotency-Key"],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": ["http://arriendos-api:8080"],
          "url_pattern": "/v2/rentals",
          "encoding": "no-op",
