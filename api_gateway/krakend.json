              "interval": 60,
              "timeout": 10,
              "max_errors": 3,
              "name": "cb-rental-create",
              "log_status_change": true
            }
          }
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "audience": ["servicio-pago-arriendo"],
          "disable_jwk_security": true,
          "issuer": "servicio-pago-arriendo-test",
          "jwk_local_path": "/etc/krakend/jwk-symmetric.json",
          "roles": ["admin"],
          "roles_key": "roles"
        },
        "qos/ratelimit/router": {
          "max_rate": 100,
          "every": "1s",
          "capacity": 100,
          "client_max_rate": 10,
          "client_capacity": 10,
          "strategy": "ip"
        }
      }
    },
